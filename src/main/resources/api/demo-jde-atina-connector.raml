#%RAML 1.0
title: JDE Atina Connector Demo
version: v1
documentation:
 - title: Home
   content: |
     Showing Atina JDE Connector.  

/v1:
  /login:
    post:
      description: |
        Authenticates a JDE user through the Atina microservice and returns a session token
        in the X-Approver-Token response header.
        This endpoint must be called before any other operation.
        The returned token must be included in the X-Approver-Token header on all subsequent requests.
      body:
        application/json:
          type: |
            {
              "type": "object",
              "properties": {
                "user": {
                  "type": "string",
                  "displayName": "JDE Username",
                  "description": "JDE username. Stored as uppercase."
                },
                "password": {
                  "type": "string",
                  "displayName": "JDE Password",
                  "description": "JDE password."
                },
                "environment": {
                  "type": "string",
                  "displayName": "JDE Environment",
                  "description": "JDE environment name. Defaults to JDV920 if not provided.",
                  "default": "JDV920"
                },
                "role": {
                  "type": "string",
                  "displayName": "JDE Role",
                  "description": "JDE role. Use *ALL to inherit all roles assigned to the user.",
                  "default": "*ALL"
                }
              },
              "required": ["user", "password"]
            }
          example: |
            {
              "user": "JDOE",
              "password": "MyPass123!",
              "environment": "JDV920",
              "role": "*ALL"
            }
      responses:
        200:
          description: Authentication successful.
          headers:
            X-Approver-Token:
              displayName: Approver Token
              type: string
              required: true
              description: >
                JDE session token for this user. Store this value and send it
                in the X-Approver-Token header on every subsequent request.
          body:
            application/json:
              type: |
                {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "string",
                      "description": "Authenticated JDE username (uppercase)."
                    },
                    "environment": {
                      "type": "string",
                      "description": "JDE environment the session was opened against."
                    },
                    "role": {
                      "type": "string",
                      "description": "JDE role applied to this session."
                    },
                    "expiresAt": {
                      "type": "string",
                      "description": "ISO-8601 datetime when the token expires."
                    }
                  }
                }
              example: |
                {
                  "user": "JDOE",
                  "environment": "JDV920",
                  "role": "*ALL",
                  "expiresAt": "2025-05-24T18:30:00Z"
                }
        401:
          description: Invalid JDE credentials.
          body:
            application/json:
              type: |
                {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              example: |
                {
                  "code": "INVALID_CREDENTIALS",
                  "message": "Authentication failed for user JDOE. Please verify username and password."
                }
        503:
          description: Atina gRPC microservice unavailable.

  /getPurchaseOrdersForApprover:
    get:
      description: |
        Get pending purchase orders for the approver identified by a custom token header.
        If the current session/token is still valid or renewed, a new JDEToken is returned
        in the response headers for subsequent calls.
      headers:
        X-Approver-Token:
          displayName: Approver Token
          type: string
          required: true
          description: Custom token that identifies the JDE approver/session in Atina Microservice.
      responses:
        200:
          description: OK
          headers:
            X-Approver-Token:
              displayName: JDE Token
              type: string
              required: true
              description: >
                New or refreshed JDE session token. Clients should store and send this
                token in subsequent requests where required.
          body:
            application/json:
              type: |
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "documentCompanyKeyOrderNo": {
                        "type": "string"
                      },
                      "documentOrderTypeCode": {
                        "type": "string"
                      },
                      "documentOrderInvoiceNumber": {
                        "type": "integer"
                      },
                      "documentSuffix": {
                        "type": "string"
                      },
                      "statusApproval": {
                        "type": "string"
                      },
                      "approvalRoutingCodePurchaseOrder": {
                        "type": "string"
                      },
                      "entityNameOriginator": {
                        "type": "string"
                      },
                      "entityNameSupplier": {
                        "type": "string"
                      },
                      "entityNameShipTo": {
                        "type": "string"
                      },
                      "dateTransaction": {
                        "type": "string",
                        "description": "Transaction date in ISO format (YYYY-MM-DD)"
                      },
                      "currencyMode": {
                        "type": "string"
                      },
                      "amountGross": {
                        "type": "number"
                      },
                      "currencyCodeBase": {
                        "type": "string"
                      },
                      "amountForeign": {
                        "type": "number"
                      },
                      "currencyCodeForeign": {
                        "type": "string"
                      },
                      "businessUnitCode": {
                        "type": "string"
                      }
                    }
                  }
                }
              example: |
                [
                  {
                    "documentCompanyKeyOrderNo": "00001",
                    "documentOrderTypeCode": "OP",
                    "documentOrderInvoiceNumber": 5067,
                    "documentSuffix": "000",
                    "statusApproval": "2N",
                    "approvalRoutingCodePurchaseOrder": "DEMO",
                    "entityNameOriginator": "Financial/Distribution Company --",
                    "entityNameSupplier": "Parts Emporium",
                    "entityNameShipTo": "Parts Emporium",
                    "dateTransaction": "2021-03-21",
                    "currencyMode": "D",
                    "amountGross": 876755,
                    "currencyCodeBase": "USD",
                    "amountForeign": 0,
                    "currencyCodeForeign": "USD",
                    "businessUnitCode": "          30"
                  }
                ]
  /getPurchaseOrderDetailForApprover:
    get:
      description: Get purchase order line details for the approver identified by a custom token header.
      headers:
        X-Approver-Token:
          displayName: Approver Token
          type: string
          required: true
          description: Custom token that identifies the JDE approver/session in Atina Microservice.
      queryParameters:
        documentCompanyKeyOrderNo:
          displayName: Document Company Key Order No
          type: string
          required: true
        documentOrderTypeCode:
          displayName: Document Order Type Code
          type: string
          required: true
        documentOrderInvoiceNumber:
          displayName: Document Order / Invoice Number
          type: integer
          required: true
        documentSuffix:
          displayName: Document Suffix
          type: string
          required: true
      responses:
        200:
          description: OK
          body:
            application/json:
              type: |
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "companyKeyOrderNo": {
                        "type": "string"
                      },
                      "documentLineNumber": {
                        "type": "integer"
                      },
                      "identifierShortItem": {
                        "type": "integer"
                      },
                      "dateRequested": {
                        "type": "string",
                        "description": "Requested date in ISO format (YYYY-MM-DD)"
                      },
                      "identifier2ndItem": {
                        "type": "string"
                      },
                      "descriptionLine1": {
                        "type": "string"
                      },
                      "subledgerTypeCode": {
                        "type": "string"
                      },
                      "companyKeyRelated": {
                        "type": "string"
                      },
                      "poSoLineNoRelated": {
                        "type": "integer"
                      },
                      "documentSuffix": {
                        "type": "string"
                      },
                      "lineTypeCode": {
                        "type": "string"
                      },
                      "orderTypeCodeRelated": {
                        "type": "string"
                      },
                      "poSoNumberRelated": {
                        "type": "string"
                      },
                      "acctNumber": {
                        "type": "string"
                      },
                      "amountForeignExtendPrice": {
                        "type": "number"
