                          },
                          "entityId": {
                            "type": "integer"
                          }
                        }
                      },
                      "unitOfMeasurePurchasing": {
                        "type": "string"
                      },
                      "businessUnitCode": {
                        "type": "string"
                      },
                      "statusLastCode": {
                        "type": "string"
                      },
                      "unitsTransactionQty": {
                        "type": "number"
                      },
                      "documentOrderTypeCode": {
                        "type": "string"
                      },
                      "statusCodeNextCode": {
                        "type": "string"
                      },
                      "documentOrderInvoiceNumber": {
                        "type": "integer"
                      },
                      "foreignPurchasingPrice": {
                        "type": "number"
                      },
                      "dateTransaction": {
                        "type": "string",
                        "description": "Transaction date in ISO format (YYYY-MM-DD)"
                      },
                      "amountExtendedPrice": {
                        "type": "number"
                      },
                      "assetIDNumber": {
                        "type": "string"
                      },
                      "purchasingUnitPrice": {
                        "type": "number"
                      },
                      "discountFactor": {
                        "type": "number"
                      },
                      "subledger": {
                        "type": "string"
                      },
                      "unitOfMeasureCode": {
                        "type": "string"
                      },
                      "shipTo": {
                        "type": "object",
                        "properties": {
                          "entityTaxId": {
                            "type": ["string", "null"]
                          },
