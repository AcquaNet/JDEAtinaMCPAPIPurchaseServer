  /processPurchaseOrderApproveReject:
    post:
      description: Process a purchase order action (approve or reject) for the approver identified by a custom token header.
      
      headers:
        X-Approver-Token:
          displayName: Approver Token
          type: string
          required: true
          description: Custom token that identifies the JDE approver/session in Atina Microservice.

      body:
        application/json:
          type: |
            {
              "type": "object",
              "properties": {

                "documentCompanyKeyOrderNo": {
                  "type": "string",
                  "displayName": "Document Company Key Order No",
                  "description": "Company key for the order"
                },

                "documentOrderTypeCode": {
                  "type": "string",
                  "displayName": "Document Order Type Code",
                  "description": "Order type code (e.g. OP)"
                },

                "documentOrderInvoiceNumber": {
                  "type": "number",
                  "displayName": "Document Order / Invoice Number",
                  "description": "Order number"
                },

                "documentSuffix": {
                  "type": "string",
                  "displayName": "Document Suffix",
                  "description": "Document suffix"
                }, 
                
                "action": {
                  "type": "string",
                  "enum": ["A", "R"],
                  "displayName": "Action",
                  "description": "A = Approve, R = Reject"
                },

                "remark": {
                  "type": "string",
                  "maxLength": 30,
                  "displayName": "Remark",
                  "description": "Optional comment describing the reason for approval or rejection"
                }
              },
              "required": [
                "documentCompanyKeyOrderNo",
                "documentOrderTypeCode",
                "documentOrderInvoiceNumber",
                "documentSuffix",
                "action",
                "remark"
              ]
            }

          example: |
            {
              "documentCompanyKeyOrderNo": "00001",
              "documentOrderTypeCode": "OP",
              "documentOrderInvoiceNumber": 5070,
              "documentSuffix": "000",
              "action": "A",
              "remark": "Approved Demo"
            }

      responses:
        200:
          description: OK
          body:
            application/json:
              type: |
                {
                  "type": "object",
                  "properties": {
                    "confirmApproveRejectSucess": {
                      "type": "string",
                      "description": "Processing result flag. '0' indicates success."
                    },
                    "numberOfPurchaseOrdersProcessed": {
                      "type": "integer",
                      "description": "Number of purchase orders processed during this operation."
                    }
                  }
                }
              example: |
                {
                  "confirmApproveRejectSucess": "1",
                  "numberOfPurchaseOrdersProcessed": 1
                }